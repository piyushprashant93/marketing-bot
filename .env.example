# Delay between messages (in seconds)
MIN_DELAY=30
MAX_DELAY=90

# Max messages per run
MAX_MESSAGES=50

# Default message template (1=cold outreach, 2=follow-up, 3=quick pitch)
DEFAULT_TEMPLATE=1

# Google Maps API Key (needs Places API enabled)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Mailtrap SMTP (Email Marketing)
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM_EMAIL=your_email@example.com
MAIL_FROM_NAME="Your Name"

# Email campaign settings
EMAIL_DELAY_SECONDS=5
EMAIL_MAX_PER_RUN=50

# Instagram Automation Config
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password
INSTA_MAX_MESSAGES=2000
INSTA_DELAY_MIN=15
INSTA_DELAY_MAX=30
